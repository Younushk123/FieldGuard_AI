rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userProfile(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function sameTeam(teamId) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userProfile(request.auth.uid).status == 'active'
        && userProfile(request.auth.uid).teamId == teamId;
    }

    // ---------- inspections ----------

    function validAnalysis(a) {
      return a is map
        && a.analysisStatus in ['pending', 'done', 'failed']
        && (!('rationale' in a)
            || (a.rationale is string && a.rationale.size() <= 500))
        && (!('recommendations' in a)
            || (a.recommendations is list
                && a.recommendations.size() >= 1
                && a.recommendations.size() <= 5))
        && (!('requiresImmediateAction' in a)
            || a.requiresImmediateAction is bool)
        && (!('uncertaintyNotes' in a)
            || a.uncertaintyNotes == null
            || (a.uncertaintyNotes is string && a.uncertaintyNotes.size() <= 300));
    }

    function validInspection(d) {
      return d.keys().hasOnly([
          'ownerId', 'teamId', 'site', 'location', 'createdAt', 'updatedAt', 'reportText', 'schemaVersion',
          'hazardCategory', 'likelihood', 'severity', 'summary',
          'suggestedAction', 'riskScore', 'riskLevel', 'inferenceSource',
          'status', 'reviewedBy', 'reviewedAt', 'analysis', 'inferenceMs'
        ])
        && d.keys().hasAll([
          'ownerId', 'createdAt', 'updatedAt', 'reportText', 'schemaVersion',
          'hazardCategory', 'likelihood', 'severity', 'summary',
          'suggestedAction', 'riskScore', 'riskLevel', 'inferenceSource',
          'status'
        ])
        && d.ownerId is string
        && (!('site' in d) || (d.site is string && d.site.size() > 0 && d.site.size() <= 100))
        && (!('location' in d) || (d.location is string && d.location.size() <= 200))
        && d.createdAt is timestamp
        && d.updatedAt is timestamp
        && d.reportText is string && d.reportText.size() > 0
        && d.schemaVersion == '1.0'
        && d.hazardCategory in [
          'fall', 'electrical', 'fire', 'chemical',
          'mechanical', 'ergonomic', 'environmental', 'other'
        ]
        && d.likelihood is int && d.likelihood >= 1 && d.likelihood <= 5
        && d.severity is int && d.severity >= 1 && d.severity <= 5
        && d.summary is string && d.summary.size() >= 1 && d.summary.size() <= 200
        && d.suggestedAction is string
        && d.suggestedAction.size() >= 1 && d.suggestedAction.size() <= 200
        && d.riskScore is int && d.riskScore == d.likelihood * d.severity
        && d.riskLevel in ['low', 'medium', 'high', 'critical']
        && d.inferenceSource in ['on-device', 'cloud']
        && d.status in ['pending_review', 'approved']
        && (!('reviewedBy' in d) || d.reviewedBy is string)
        && (!('reviewedAt' in d) || d.reviewedAt is timestamp)
        && (!('analysis' in d) || validAnalysis(d.analysis))
        && (!('inferenceMs' in d) || (d.inferenceMs is int && d.inferenceMs >= 0 && d.inferenceMs <= 120000));
    }

    match /inspections/{id} {
      allow get: if signedIn()
        && (resource == null
          || resource.data.ownerId == request.auth.uid
          || ('teamId' in resource.data && sameTeam(resource.data.teamId)));
      allow list: if signedIn()
        && (resource.data.ownerId == request.auth.uid
          || ('teamId' in resource.data && sameTeam(resource.data.teamId)));
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && (!('teamId' in request.resource.data)
          || sameTeam(request.resource.data.teamId))
        && validInspection(request.resource.data);
      allow update: if signedIn()
        && (resource.data.ownerId == request.auth.uid
          || ('teamId' in resource.data && sameTeam(resource.data.teamId)))
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && validInspection(request.resource.data);
      allow delete: if false;
    }

    // ---------- actions ----------

    function validAction(d) {
      return d.keys().hasOnly([
          'inspectionId', 'ownerId', 'teamId', 'title', 'description', 'priority',
          'status', 'assignee', 'deadline', 'createdAt', 'updatedAt'
        ])
        && d.keys().hasAll([
          'inspectionId', 'ownerId', 'title', 'status', 'createdAt', 'updatedAt'
        ])
        && d.inspectionId is string
        && d.ownerId is string
        && d.title is string && d.title.size() > 0
        && d.status in ['open', 'in_progress', 'resolved']
        && d.createdAt is timestamp
        && d.updatedAt is timestamp
        && (!('description' in d) || d.description is string)
        && (!('priority' in d)
            || d.priority in ['immediate', 'short_term', 'long_term'])
        && (!('assignee' in d) || d.assignee is string)
        && (!('deadline' in d) || d.deadline is timestamp);
    }

    match /actions/{id} {
      allow get: if signedIn()
        && (resource == null
          || resource.data.ownerId == request.auth.uid
          || ('teamId' in resource.data && sameTeam(resource.data.teamId)));
      allow list: if signedIn()
        && (resource.data.ownerId == request.auth.uid
          || ('teamId' in resource.data && sameTeam(resource.data.teamId)));
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && (!('teamId' in request.resource.data)
          || sameTeam(request.resource.data.teamId))
        && validAction(request.resource.data);
      allow update: if signedIn()
        && (resource.data.ownerId == request.auth.uid
          || ('teamId' in resource.data && sameTeam(resource.data.teamId)))
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.inspectionId == resource.data.inspectionId
        && validAction(request.resource.data);
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // ---------- user-created custom sites ----------

    function validCustomSite(d) {
      return d.keys().hasOnly(['ownerId', 'teamId', 'name', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['ownerId', 'name', 'createdAt', 'updatedAt'])
        && d.ownerId is string
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.createdAt is timestamp
        && d.updatedAt is timestamp;
    }

    match /customSites/{id} {
      allow get: if signedIn()
        && (resource == null
          || resource.data.ownerId == request.auth.uid
          || ('teamId' in resource.data && sameTeam(resource.data.teamId)));
      allow list: if signedIn()
        && (resource.data.ownerId == request.auth.uid
          || ('teamId' in resource.data && sameTeam(resource.data.teamId)));
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && (!('teamId' in request.resource.data)
          || sameTeam(request.resource.data.teamId))
        && validCustomSite(request.resource.data);
      allow update: if signedIn()
        && (resource.data.ownerId == request.auth.uid
          || ('teamId' in resource.data && sameTeam(resource.data.teamId)))
        && request.resource.data.ownerId == resource.data.ownerId
        && validCustomSite(request.resource.data);
      allow delete: if signedIn()
        && (resource.data.ownerId == request.auth.uid
          || ('teamId' in resource.data && sameTeam(resource.data.teamId)));
    }

    // ---------- teams and user profiles ----------

    function validUserProfile(d) {
      return d.keys().hasOnly([
          'uid', 'email', 'role', 'teamId', 'teamName', 'status', 'createdAt', 'updatedAt'
        ])
        && d.uid is string
        && d.email is string
        && d.role in ['manager', 'member']
        && d.teamId is string
        && d.status in ['active', 'disabled'];
    }

    match /teams/{teamId} {
      allow create: if signedIn()
        && teamId == request.auth.uid
        && request.resource.data.managerUid == request.auth.uid
        && request.resource.data.inviteCode is string;
      allow read: if signedIn() && sameTeam(teamId);
      allow update: if signedIn()
        && sameTeam(teamId)
        && userProfile(request.auth.uid).role == 'manager';
      allow delete: if false;
    }

    match /teamInvites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.teamId == request.auth.uid
        && request.resource.data.active == true;
      allow update: if signedIn()
        && exists(/databases/$(database)/documents/teams/$(resource.data.teamId))
        && get(/databases/$(database)/documents/teams/$(resource.data.teamId)).data.managerUid == request.auth.uid;
      allow delete: if false;
    }

    match /users/{uid} {
      allow get: if signedIn()
        && (uid == request.auth.uid
          || ('teamId' in resource.data && sameTeam(resource.data.teamId)));
      allow list: if signedIn()
        && (resource.data.teamId is string
          && sameTeam(resource.data.teamId));
      allow create: if signedIn()
        && uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && validUserProfile(request.resource.data);
      allow update: if signedIn()
        && ((uid == request.auth.uid
          || (exists(/databases/$(database)/documents/users/$(uid))
            && 'teamId' in resource.data
            && sameTeam(resource.data.teamId)
            && userProfile(request.auth.uid).role == 'manager'))
        && validUserProfile(request.resource.data));
      allow delete: if signedIn() && uid == request.auth.uid;
    }

    // Everything else (including any collection not listed here) is denied.
  }
}